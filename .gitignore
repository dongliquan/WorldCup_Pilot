.venv/
__pycache__/
build/
logs/
config.json

# build artifact (rebuilt via pyinstaller)
*.exe

# local analysis artifacts (generated, not part of the app)
scratch_*.json
korea_r32_telemetry.html

# Third-party data responses (ESPN, TheSportsDB, ...) and photos are fetched on first run and are NOT committed:
# redistributing them may break those services' terms. The app rebuilds them in the runtime cache.
dist/cache/

# The FIFA World Cup emblem is a FIFA trademark: keep a local copy if you like, but never commit it
assets/logo.png

# source-run cache (python server.py) — root only, not dist/cache
/cache/

# atomic-write temp files
*.tmp
dist/cache/*.tmp
